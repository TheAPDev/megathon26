# =====================================================================================
#  GREEN GHAR - API KEYS.  Copy this file to ".env" (setup.bat does it for you) and paste
#  each key after the "=".  Never commit ".env".  Leave a line empty to skip that feature.
# =====================================================================================

# ---------- 1. DATABASE: Supabase (project "green-ghar") -------------------------------
# Dashboard > Project Settings > API
SUPABASE_URL=https://rnsirfybfxfjnlhteurm.supabase.co
SUPABASE_ANON_KEY=                 # "anon" / publishable key (safe for browsers)
SUPABASE_SERVICE_ROLE_KEY=         # "service_role" or sb_secret_... key (SERVER ONLY, never share)
SUPABASE_DB_URL=                   # optional: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres (scripts only)
SUPABASE_JWT_SECRET=               # only for old HS256 projects, normally empty

# ---------- 2. AI MODEL: NVIDIA Nemotron (build.nvidia.com > API key) -------------------
NVIDIA_API_KEY=                    # nvapi-...
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_THINKING=on                 # off = faster, shorter replies
NVIDIA_REASONING_BUDGET=16384

# ---------- 3. AI fallback + voice notes: Groq (console.groq.com/keys) ------------------
GROQ_API_KEY=                      # gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# ---------- 4. Bill photo / PDF reading: Google Gemini (aistudio.google.com/apikey) -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------- 5. Telegram bot (talk to @BotFather) ----------------------------------------
TELEGRAM_BOT_TOKEN=                # 123456789:AA...
TELEGRAM_BOT_USERNAME=             # optional, looked up automatically from the token
TELEGRAM_WEBHOOK_SECRET=           # only when you use a public webhook (any long random text)

# ---------- 6. Optional voice replies (NVIDIA Magpie TTS) -------------------------------
NVIDIA_TTS_FUNCTION_ID=
NVIDIA_TTS_VOICE=

# ---------- 7. App settings (usually leave as is) ---------------------------------------
GG_REPO=local                      # local = bundled dataset | supabase = live database (connect_supabase.bat sets this)
GG_LOGIN=off                       # on = username + password sign-in screen (connect_supabase.bat sets this)
GG_ENV=dev                         # dev = open demo | prod = login required on customer routes
GG_DEMO_HOME=H000011               # demo home (HD000015 when GG_REPO=supabase)
GG_USERNAME_DOMAIN=gg-users.example.com
GG_LINK_SECRET=                    # any long random text; signs Telegram deep links
GG_ANALYST_KEYS=                   # lender-portfolio password(s), comma separated; empty = open in dev
GG_ADMIN_KEYS=
GG_CORS_ORIGINS=*
GG_MINIAPP_URL=
