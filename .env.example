# ---- runtime
# dev | prod (prod requires API keys on analyst/admin routes)
GG_ENV=dev
# local (parquet in data/generated) | supabase
GG_REPO=local
# comma-separated keys sent as X-API-Key for /portfolio and admin routes. Leave empty in dev (open);
# set them (and GG_ENV=prod) before exposing the server.
GG_ANALYST_KEYS=
GG_ADMIN_KEYS=
GG_CORS_ORIGINS=*
GG_DEMO_HOME=H000011
# dashboard URL opened from the Telegram bot
GG_MINIAPP_URL=

# ---- Supabase (server-side only; never ship the service-role key to clients)
SUPABASE_URL=https://rnsirfybfxfjnlhteurm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# postgresql://postgres:<password>@db.rnsirfybfxfjnlhteurm.supabase.co:5432/postgres (scripts only)
SUPABASE_DB_URL=

# ---- LLM chain: NVIDIA NIM (Nemotron 3.5 Lightning) -> Groq -> template. Keys stay on the server only.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Nemotron reasoning (thinking) settings; set NVIDIA_THINKING=off for faster, shorter replies
NVIDIA_THINKING=on
NVIDIA_REASONING_BUDGET=16384
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- speech, OCR, chat
GROQ_STT_MODEL=whisper-large-v3
# Magpie TTS Multilingual function id (build.nvidia.com API tab)
NVIDIA_TTS_FUNCTION_ID=
NVIDIA_TTS_VOICE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---- web app ----------------------------------------------------------------------------------
# Public anon key (safe to expose). The app shows the username + password screen only when GG_LOGIN=on
# (scripts/connect_supabase.py turns it on once the service-role key is saved, so sign-up can create accounts).
# Usernames map to <username>@GG_USERNAME_DOMAIN inside Supabase Auth; the address is never mailed.
GG_USERNAME_DOMAIN=gg-users.example.com
SUPABASE_ANON_KEY=
GG_LOGIN=off
# Only for legacy HS256 projects; new projects verify tokens via JWKS automatically
SUPABASE_JWT_SECRET=
# Telegram bot username for "Continue on Telegram" deep links, and the secret that signs them
TELEGRAM_BOT_USERNAME=
GG_LINK_SECRET=
# Comma-separated origins allowed to call the API from a browser (only needed if the app is hosted elsewhere)
GG_CORS_ORIGINS=*
